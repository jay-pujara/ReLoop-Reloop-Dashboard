      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.supplier@example.com\",\n  \"password\": \"Secret12345!\",\n  \"name\": \"John Doe\",\n  \"organizationName\": \"Acme Packaging Corp\",\n  \"organizationType\": \"manufacturer\",\n  \"city\": \"Chicago\",\n  \"country\": \"USA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.supplier@example.com\",\n  \"password\": \"Secret12345!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Materials",
      "item": [
        {
          "name": "List Materials",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/materials?page=1&limit=20&materialType=cardboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "materials"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "materialType", "value": "cardboard" }
              ]
            }
          }
        },
        {
          "name": "Create Material Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Surplus Double-Wall Corrugated Boxes\",\n  \"description\": \"Clean unprinted boxes, overstock lot.\",\n  \"materialType\": \"cardboard\",\n  \"condition\": \"new\",\n  \"quantity\": 500,\n  \"unit\": \"units\",\n  \"pricePerUnit\": 0.85,\n  \"isFreeClaim\": false,\n  \"pickupLocation\": {\n    \"address\": \"4500 Industrial Pkwy\",\n    \"city\": \"Chicago\",\n    \"location\": {\n      \"type\": \"Point\",\n      \"coordinates\": [-87.6298, 41.8781]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/materials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "materials"]
            }
          }
        }
      ]
